<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>WASD Enterprise – дигитални книги онлайн</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Unbounded:wght@600;700&display=swap&subset=cyrillic">
<style>
:root{
  --bg:#fafbfe;--soft:#f0f2f8;--ink:#0f1629;--muted:#626d8a;--line:#dde1ec;
  --accent:#f59e0b;--accent2:#f97316;--accent-ink:#0f1629;--card:#ffffff;
  --success:#10b981;--danger:#ef4444;--info:#3b82f6;
  --radius:16px;--radius-lg:24px;--shadow:0 4px 24px -6px rgba(15,22,41,.08);
  --shadow-lg:0 20px 60px -12px rgba(15,22,41,.18);
  --shadow-xl:0 32px 80px -20px rgba(15,22,41,.22);
  --glass:rgba(255,255,255,.72);--glass-border:rgba(255,255,255,.4);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)
}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0b0f1a;--soft:#131829;--ink:#e8ecf4;--muted:#8892ad;--line:#1e2540;
  --card:#151b2e;--glass:rgba(21,27,46,.82);--glass-border:rgba(255,255,255,.08);
  --shadow:0 4px 24px -6px rgba(0,0,0,.3);--shadow-lg:0 20px 60px -12px rgba(0,0,0,.5);
  --shadow-xl:0 32px 80px -20px rgba(0,0,0,.55)
}}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{background:var(--bg);color:var(--ink);font-family:Inter,system-ui,'Segoe UI',sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:8px}
[hidden]{display:none!important}

/* Layout */
.wrap{max-width:1140px;margin:0 auto;padding:0 28px}
@media(max-width:640px){.wrap{padding:0 18px}}

/* Header */
header{position:sticky;top:0;z-index:100;background:var(--glass);backdrop-filter:blur(20px) saturate(1.4);border-bottom:1px solid var(--glass-border);transition:box-shadow .3s}
header.scrolled{box-shadow:var(--shadow)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}
.logo{display:flex;align-items:center;gap:11px;font-family:Unbounded,Verdana,sans-serif;font-weight:700;font-size:16px;letter-spacing:-.01em}
.mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#0f1629;display:grid;place-items:center;font-size:15px;font-weight:800;box-shadow:0 2px 8px rgba(245,158,11,.35)}
nav{display:flex;gap:28px}
nav a{color:var(--muted);font-size:15px;font-weight:500;position:relative;padding:4px 0;transition:color .2s}
nav a::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:2px;background:var(--accent);border-radius:1px;transition:width .25s}
nav a:hover{color:var(--ink)}
nav a:hover::after{width:100%}
@media(max-width:720px){nav{display:none}}
.cartbtn{display:inline-flex;gap:8px;align-items:center;font-weight:600;font-size:14px;padding:10px 18px;border-radius:999px;background:var(--soft);border:1px solid var(--line);transition:all .2s;cursor:pointer}
.cartbtn:hover{background:var(--card);box-shadow:var(--shadow);transform:translateY(-1px)}
.cartbtn b{background:linear-gradient(135deg,#f59e0b,#f97316);color:#0f1629;min-width:22px;height:22px;border-radius:11px;display:inline-grid;place-items:center;font-size:12px;padding:0 6px;font-weight:700}
@keyframes bump{40%{transform:scale(1.3)}}
.cartbtn b.bump{animation:bump .35s ease}

/* Hero */
.hero{padding:100px 0 80px;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:center}
@media(max-width:860px){.hero{padding:64px 0 56px}.hero .wrap{grid-template-columns:1fr;gap:48px;text-align:center}}
h1{font-family:Unbounded,Verdana,sans-serif;font-size:clamp(32px,5vw,52px);line-height:1.08;letter-spacing:-.03em;font-weight:700;margin:0 0 20px}
h1 span{background:linear-gradient(135deg,#f59e0b,#f97316);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lead{font-size:18px;color:var(--muted);margin:0 0 36px;max-width:32em;line-height:1.65}
.btns{display:flex;gap:14px;flex-wrap:wrap}
@media(max-width:860px){.btns{justify-content:center}.lead{margin-inline:auto}}
.btn{display:inline-flex;align-items:center;gap:8px;padding:15px 28px;border-radius:14px;font-weight:600;font-size:16px;border:1px solid transparent;transition:all .25s;cursor:pointer}
.btn.p{background:linear-gradient(135deg,#f59e0b,#f97316);color:#0f1629;box-shadow:0 4px 16px -4px rgba(245,158,11,.4)}
.btn.p:hover{transform:translateY(-2px);box-shadow:0 8px 24px -4px rgba(245,158,11,.5);filter:brightness(1.05)}
.btn.s{border-color:var(--line);color:var(--ink);background:var(--card)}
.btn.s:hover{background:var(--soft);transform:translateY(-2px);box-shadow:var(--shadow)}
.btn.big{font-size:18px;padding:18px 40px;border-radius:16px}

/* Book Stack */
.stack{position:relative;height:380px}
@media(max-width:860px){.stack{max-width:360px;margin:0 auto}}
.bk{position:absolute;width:180px;height:260px;border-radius:6px 16px 16px 6px;padding:22px 20px;color:#fff;font-weight:700;font-size:19px;line-height:1.2;display:flex;flex-direction:column;justify-content:space-between;box-shadow:var(--shadow-lg);border-left:8px solid rgba(0,0,0,.2);transition:transform .4s ease}
.bk small{font-weight:500;font-size:12px;opacity:.8;letter-spacing:.03em}
.bk.a{left:0;top:50px;transform:rotate(-8deg);background:linear-gradient(145deg,#3b5cb8,#2c4a8f)}
.bk.b{left:85px;top:10px;transform:rotate(2deg);background:linear-gradient(145deg,#1f9d7a,#1a6b56);z-index:2}
.bk.c{left:175px;top:60px;transform:rotate(10deg);background:linear-gradient(145deg,#b8486a,#8d3d52)}
.bk:hover{transform:translateY(-8px) rotate(0deg)!important;box-shadow:var(--shadow-xl)}
@keyframes bob{50%{translate:0 -10px}}
.bk{animation:bob 5s ease-in-out infinite}.bk.b{animation-delay:-1.6s}.bk.c{animation-delay:-3.2s}
.chip{position:absolute;right:-8px;bottom:0;z-index:3;width:230px;background:var(--glass);backdrop-filter:blur(16px);border:1px solid var(--glass-border);border-radius:16px;padding:14px 18px;font-size:14px;box-shadow:var(--shadow-lg)}
.chip b{display:flex;align-items:center;gap:8px}
.chip .ok-dot{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--success);color:#fff;font-size:11px}
@keyframes pulse{0%,70%{opacity:0;scale:.6}80%,100%{opacity:1;scale:1}}
.chip .ok-dot{animation:pulse 3.6s ease-in-out infinite}
.bar{height:6px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,#f59e0b,#f97316)}
@keyframes fill{0%{width:0}70%,100%{width:100%}}
.bar i{animation:fill 3.6s ease-in-out infinite}
@media(max-width:440px){.bk{width:140px;height:200px;font-size:15px}.bk.b{left:60px}.bk.c{left:125px}.stack{height:280px}}

/* Facts */
.facts{background:var(--soft);border-block:1px solid var(--line)}
.facts .wrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;padding-block:36px}
.facts>div{text-align:center}
.fact-icon{font-size:28px;margin-bottom:8px}
.facts b{display:block;font-size:16px;margin-bottom:2px}
.facts span{color:var(--muted);font-size:14px}

/* Sections */
section{padding:88px 0}
h2{font-family:Unbounded,Verdana,sans-serif;font-size:clamp(24px,3.4vw,34px);line-height:1.15;letter-spacing:-.02em;font-weight:700;margin:0 0 12px}
.sub{color:var(--muted);margin:0 0 40px;max-width:36em;font-size:17px}
.alt{background:var(--soft)}

/* Categories */
.cats{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}
.cat{display:flex;gap:18px;align-items:center;padding:22px;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);transition:all .3s;cursor:pointer}
.cat:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:transparent}
.sw{flex:none;width:48px;height:64px;border-radius:4px 10px 10px 4px;border-left:5px solid rgba(0,0,0,.18);transition:transform .3s}
.cat:hover .sw{transform:rotate(-6deg)}
.cat h3{margin:0;font-size:16px;font-weight:600}
.cat p{margin:4px 0 0;color:var(--muted);font-size:14px;line-height:1.45}

/* Steps */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;counter-reset:s;padding:0;list-style:none;margin:0}
.steps li{counter-increment:s;padding:28px;border-radius:var(--radius);background:var(--card);border:1px solid var(--line);transition:all .3s}
.steps li:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.steps li::before{content:counter(s);display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#f97316);color:#0f1629;font-weight:700;margin-bottom:16px;font-size:15px}
.steps h3{margin:0 0 6px;font-size:17px;font-weight:600}
.steps p{margin:0;color:var(--muted);font-size:14px;line-height:1.55}

/* FAQ */
details{border-bottom:1px solid var(--line);padding:20px 0}
summary{cursor:pointer;font-weight:600;font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:16px;transition:color .2s}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';font-size:22px;line-height:1;color:var(--muted);transition:transform .3s}
details[open] summary::after{content:'−';transform:rotate(180deg)}
summary:hover{color:var(--accent)}
details p{margin:12px 0 0;color:var(--muted);max-width:42em;font-size:15px}

/* Contact */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
@media(max-width:760px){.contact{grid-template-columns:1fr}}
dl{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:14px 28px;font-size:15px}
dt{color:var(--muted);font-weight:500}dd{margin:0;font-weight:600;overflow-wrap:anywhere}

/* Devices section */
.devs{padding:72px 0 8px}
.devs svg{display:block;width:100%;max-width:720px;height:auto;margin:0 auto}
.devs .ln{fill:#fff;opacity:.55}
.devs .shim{fill:url(#sh)}
.devs h2,.devs .sub{text-align:center;margin-inline:auto}

/* Scenes */
.scenes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
.scene{margin:0;border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line);background:var(--card);transition:all .3s}
.scene:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.scene svg{display:block;width:100%;height:auto}
.scene figcaption{padding:16px 20px;color:var(--muted);font-size:14px}
.scene figcaption b{color:var(--ink);display:block;font-size:15px}

/* Catalog */
.cat-top{padding:40px 0 8px}
.back{display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-weight:500;font-size:15px;margin-bottom:24px;transition:color .2s}
.back:hover{color:var(--ink)}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0 32px}
.chip2{padding:9px 18px;border-radius:999px;border:1px solid var(--line);font-size:14px;font-weight:500;color:var(--muted);transition:all .2s;background:var(--card)}
.chip2:hover{background:var(--soft);color:var(--ink);transform:translateY(-1px)}
.chip2.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}

/* Shelf / items */
.shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px;padding-bottom:80px}
.item{display:flex;flex-direction:column;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;transition:all .3s}
.item:hover{box-shadow:var(--shadow-lg);transform:translateY(-4px);border-color:transparent}
.item .cv{aspect-ratio:3/4;border-radius:6px 14px 14px 6px;border-left:8px solid rgba(0,0,0,.2);padding:20px 18px;color:#fff;font-weight:700;font-size:18px;line-height:1.2;display:flex;align-items:flex-end;box-shadow:var(--shadow);transition:transform .3s;position:relative;overflow:hidden}
.item .cv img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.item .cv span{position:relative;z-index:1;text-shadow:0 2px 8px rgba(0,0,0,.6)}
.item:hover .cv{transform:translateY(-4px) rotate(-1.5deg)}
.item h3{margin:0;font-size:16px;line-height:1.3;font-weight:600}
.item p{margin:0;color:var(--muted);font-size:13px}
.item .pr{font-weight:700;font-size:20px;margin:4px 0 0;background:linear-gradient(135deg,#f59e0b,#f97316);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.item-btns{display:flex;gap:8px;margin-top:auto}
.item-btns button{flex:1;font:inherit;font-weight:600;font-size:13px;padding:10px 8px;border:0;border-radius:10px;cursor:pointer;transition:all .2s}
.item-btns .add-btn{background:linear-gradient(135deg,#f59e0b,#f97316);color:#0f1629}
.item-btns .add-btn:hover{filter:brightness(1.05);transform:translateY(-1px);box-shadow:0 4px 12px -2px rgba(245,158,11,.4)}
.item-btns .add-btn.in{background:var(--success);color:#fff}
.item-btns .add-btn.in:hover{filter:brightness(1.05)}
.item-btns .browse-btn{background:var(--soft);color:var(--ink);border:1px solid var(--line)}
.item-btns .browse-btn:hover{background:var(--card);box-shadow:var(--shadow);transform:translateY(-1px)}

/* Checkout */
.co{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:start;padding-bottom:80px}
@media(max-width:860px){.co{grid-template-columns:1fr;gap:32px}.sum{order:-1}}
.co form{display:grid;gap:20px}
.fld label{display:block;font-weight:600;font-size:14px;margin-bottom:8px;color:var(--muted)}
.fld input[type=text],.fld input[type=email]{width:100%;font:inherit;font-size:16px;padding:14px 18px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--ink);transition:all .2s}
.fld input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 4px rgba(245,158,11,.12)}
.chk{display:flex;gap:12px;align-items:flex-start;color:var(--muted);font-size:14px;line-height:1.5}
.chk input{margin-top:4px;width:20px;height:20px;accent-color:#f59e0b;border-radius:4px}
.sum{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-lg);padding:28px;position:sticky;top:88px;box-shadow:var(--shadow)}
.sum h3{margin:0 0 20px;font-size:18px;font-weight:700}
.sum ul{list-style:none;margin:0;padding:0}
.sum li{display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line);font-size:14px;align-items:flex-start}
.sum li small{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.sum li .rm{background:none;border:0;color:var(--danger);cursor:pointer;font:inherit;font-size:12px;padding:0;text-decoration:underline;opacity:.7;transition:opacity .2s}
.sum li .rm:hover{opacity:1}
.tot{display:flex;justify-content:space-between;font-size:22px;font-weight:700;padding-top:20px}
.sum>p{color:var(--muted);font-size:13px;margin:14px 0 0}
.ok-msg{display:none;padding:18px;border-radius:14px;background:#ecfdf5;color:#065f46;font-size:15px;font-weight:500;border:1px solid #a7f3d0}
.ok-msg.show{display:block}
.sumup-info{margin-top:16px;padding:16px;border-radius:12px;background:var(--soft);border:1px solid var(--line);font-size:13px;color:var(--muted)}
.sumup-info b{color:var(--ink);display:block;margin-bottom:4px;font-size:14px}

/* SumUp badge */
.sumup-badge{display:flex;align-items:center;gap:10px;margin-top:16px;padding:14px 18px;border-radius:14px;background:linear-gradient(135deg,#001b38,#003366);color:#fff;font-size:14px;font-weight:500}
.sumup-badge svg{flex:none}
.sumup-badge span{font-weight:600}

/* Modal */
.modal-overlay{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.5);backdrop-filter:blur(6px);place-items:center;padding:24px;opacity:0;transition:opacity .3s}
.modal-overlay.open{display:grid;opacity:1}
.modal{background:var(--card);border-radius:var(--radius-lg);max-width:520px;width:100%;max-height:85vh;overflow-y:auto;box-shadow:var(--shadow-xl);transform:scale(.95);transition:transform .3s;padding:0}
.modal-overlay.open .modal{transform:scale(1)}
.modal-header{display:flex;justify-content:space-between;align-items:flex-start;padding:28px 28px 0;gap:16px}
.modal-header h3{font-size:20px;font-weight:700;margin:0;line-height:1.3}
.modal-close{background:var(--soft);border:1px solid var(--line);width:36px;height:36px;border-radius:50%;display:grid;place-items:center;cursor:pointer;font-size:18px;color:var(--muted);transition:all .2s;flex:none}
.modal-close:hover{background:var(--line);color:var(--ink)}
.modal-body{padding:20px 28px 28px}
.modal-cover{width:100%;aspect-ratio:3/2;border-radius:12px;margin-bottom:20px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:24px;text-align:center;padding:24px;line-height:1.2;border-left:10px solid rgba(0,0,0,.2);position:relative;overflow:hidden}
.modal-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.modal-cover span{position:relative;z-index:1;text-shadow:0 2px 10px rgba(0,0,0,.7)}
.modal-desc{color:var(--muted);font-size:15px;line-height:1.7;margin-bottom:20px}
.modal-meta{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px}
.modal-meta div{padding:12px;border-radius:10px;background:var(--soft);font-size:13px}
.modal-meta div b{display:block;color:var(--ink);font-size:14px}
.modal-meta div span{color:var(--muted)}
.modal-price{font-size:26px;font-weight:800;background:linear-gradient(135deg,#f59e0b,#f97316);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:16px}
.modal-add{width:100%;font:inherit;font-weight:700;font-size:16px;padding:16px;border:0;border-radius:14px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#0f1629;cursor:pointer;transition:all .2s}
.modal-add:hover{filter:brightness(1.05);transform:translateY(-2px);box-shadow:0 8px 24px -4px rgba(245,158,11,.4)}
.modal-add.in{background:var(--success);color:#fff}

/* Reveal animation */
.rv{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.rv.in{opacity:1;transform:none}

/* Footer */
footer{border-top:1px solid var(--line);padding:32px 0;color:var(--muted);font-size:13px}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;align-items:center}
footer a{color:var(--accent);font-weight:500}

/* Animations */
@keyframes tw{50%{opacity:.2}}
@keyframes steam{0%{opacity:0;translate:0 4px}40%{opacity:.8}100%{opacity:0;translate:0 -14px}}
@keyframes glow{50%{opacity:.28}}
@keyframes spin{to{rotate:360deg}}
.tw{animation:tw 3s ease-in-out infinite}
.st{animation:steam 3s ease-in infinite}
.gl{animation:glow 5s ease-in-out infinite}
.rays{transform-box:fill-box;transform-origin:center;animation:spin 50s linear infinite}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .bk,.bar i,.chip .ok-dot,.tw,.st,.gl,.rays{animation:none}
  .bar i{width:100%}
  .rv{opacity:1;transform:none;transition:none}
}

/* Gradient blob hero deco */
.hero-deco{position:absolute;top:-120px;right:-120px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.12) 0%,transparent 70%);pointer-events:none;z-index:-1}
.hero .wrap{position:relative}
</style>
</head>
<body>
<header>
<div class="wrap">
<a class="logo" href="#top"><span class="mark" aria-hidden="true">W</span>WASD Enterprise</a>
<nav aria-label="Основно меню">
  <a href="#books">Книги</a>
  <a href="#how">Как работи</a>
  <a href="#faq">Въпроси</a>
  <a href="#contact">Контакти</a>
</nav>
<a class="cartbtn" href="#checkout" aria-label="Количка">
  🛒 Количка <b id="cc">0</b>
</a>
</div>
</header>

<main id="top">
<div class="hero"><div class="wrap">
<div class="hero-deco" aria-hidden="true"></div>
