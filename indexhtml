var home=document.getElementById('top'),cat=document.getElementById('catalog'),co=document.getElementById('checkout');
var cart=[];
try{var r=JSON.parse(localStorage.getItem('wasd-cart')||'[]');if(Array.isArray(r))cart=r.filter(function(x){return x&&typeof x.t==='string'&&typeof x.p==='number'})}catch(e){}
function save(){try{localStorage.setItem('wasd-cart',JSON.stringify(cart))}catch(e){}}
function esc(x){return String(x).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function f(n){return n.toFixed(2).replace('.',',')+' лв.'}
function has(t){return cart.some(function(x){return x.t===t})}
function total(){return cart.reduce(function(a,x){return a+x.p},0)}
var cur=null,view='home';
function badge(bump){var b=document.getElementById('cc');b.textContent=cart.length;if(bump){b.classList.remove('bump');void b.offsetWidth;b.classList.add('bump')}}

/* Find book info */
function findBook(title){
  for(var i=0;i<C.length;i++){for(var j=0;j<C[i].t.length;j++){if(C[i].t[j][0]===title)return{title:C[i].t[j][0],price:C[i].t[j][1],desc:C[i].t[j][2],img:C[i].t[j][3],cat:C[i].n,color:C[i].c,grad:C[i].g}}}
  return null;
}

/* Modal */
var modal=document.getElementById('modal');
var modalTitle=document.getElementById('modal-title');
var modalCover=document.getElementById('modal-cover');
var modalDesc=document.getElementById('modal-desc');
var modalCat=document.getElementById('modal-cat');
var modalPrice=document.getElementById('modal-price');
var modalAdd=document.getElementById('modal-add');
var modalBook=null;

function openModal(title){
  var bk=findBook(title);
  if(!bk)return;
  modalBook=bk;
  modalTitle.textContent=bk.title;
  if(bk.img){modalCover.innerHTML='<img src="'+IMG+bk.img+'" alt="'+esc(bk.title)+'">'+'<span>'+esc(bk.title)+'</span>'}else{modalCover.innerHTML='<span>'+esc(bk.title)+'</span>'}
  modalCover.style.background=bk.grad;
  modalDesc.textContent=bk.desc;
  modalCat.textContent=bk.cat;
  modalPrice.textContent=f(bk.price);
  var inCart=has(bk.title);
  modalAdd.textContent=inCart?'✓ Вече е в количката':'🛒 Добави в количка';
  modalAdd.className='modal-add'+(inCart?' in':'');
  modal.classList.add('open');
  document.body.style.overflow='hidden';
}
function closeModal(){
  modal.classList.remove('open');
  document.body.style.overflow='';
  modalBook=null;
}
document.getElementById('modal-close').addEventListener('click',closeModal);
modal.addEventListener('click',function(e){if(e.target===modal)closeModal()});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&modal.classList.contains('open'))closeModal()});
modalAdd.addEventListener('click',function(){
  if(!modalBook)return;
  if(!has(modalBook.title)){
    cart.push({t:modalBook.title,p:modalBook.price});save();badge(true);shelf();
    modalAdd.textContent='✓ Вече е в количката';
    modalAdd.classList.add('in');
  }else{
    closeModal();location.hash='#checkout';
  }
});

function shelf(){
  var out='';
  (cur?[cur]:C).forEach(function(x){x.t.forEach(function(it){var t=it[0],p=it[1],im=it[3],i=has(t);
    var cvInner=im?'<img src="'+IMG+im+'" alt="'+esc(t)+'" loading="lazy"><span>'+esc(t)+'</span>':'<span>'+esc(t)+'</span>';
    out+='<article class="item"><div class="cv" style="background:'+x.g+'">'+cvInner+'</div><div><h3>'+esc(t)+'</h3><p>'+esc(x.n)+' · EPUB, PDF</p></div><p class="pr">'+f(p)+'</p><div class="item-btns"><button type="button" class="add-btn'+(i?' in':'')+'" data-t="'+esc(t)+'" data-p="'+p+'">'+(i?'✓ В количката':'🛒 Добави')+'</button><button type="button" class="browse-btn" data-browse="'+esc(t)+'">📖 Разгледай</button></div></article>'})});
  document.getElementById('shelf').innerHTML=out;
}

function lines(){
  var l='';cart.forEach(function(x){l+='<li><span>'+esc(x.t)+'<small>EPUB, PDF</small><button type="button" class="rm" data-rm="'+esc(x.t)+'">✕ Премахни</button></span><b>'+f(x.p)+'</b></li>'});
  document.getElementById('lines').innerHTML=l;
  document.getElementById('tot').textContent=f(total());
  document.getElementById('empty').hidden=cart.length>0;
  document.getElementById('cof').hidden=cart.length===0;
}

function route(){
  var h=location.hash;cur=C.filter(function(x){return '#'+x.id===h})[0]||null;
  home.hidden=cat.hidden=co.hidden=true;
  if(h==='#all'||cur){
    view='cat';cat.hidden=false;
    document.getElementById('ct').textContent=cur?cur.n:'Нашите произведения';
    document.getElementById('cd').textContent=cur?cur.d:'Всички категории на едно място.';
    var ch='<a class="chip2'+(cur?'':' on')+'" href="#all">Всички</a>';
    C.forEach(function(x){ch+='<a class="chip2'+(x===cur?' on':'')+'" href="#'+x.id+'">'+esc(x.n)+'</a>'});
    document.getElementById('chips').innerHTML=ch;shelf();
    document.title=(cur?cur.n:'Произведения')+' – WASD Enterprise';window.scrollTo(0,0);
  }else if(h==='#checkout'){
    view='co';co.hidden=false;lines();document.title='Поръчка – WASD Enterprise';window.scrollTo(0,0);
  }else{
    var was=view!=='home';view='home';home.hidden=false;
    document.title='WASD Enterprise – дигитални книги онлайн';
    if(was){var el=h.length>1&&document.getElementById(h.slice(1));if(el){el.scrollIntoView()}else{window.scrollTo(0,0)}}
  }
}

document.addEventListener('click',function(e){
  var a=e.target.closest&&e.target.closest('[data-t]');
  var r=e.target.closest&&e.target.closest('[data-rm]');
  var br=e.target.closest&&e.target.closest('[data-browse]');
  if(a){var t=a.getAttribute('data-t');if(!has(t)){cart.push({t:t,p:parseFloat(a.getAttribute('data-p'))});save();badge(true);shelf()}else{location.hash='#checkout'}}
  if(r){var t2=r.getAttribute('data-rm');cart=cart.filter(function(x){return x.t!==t2});save();badge(false);lines()}
  if(br){e.preventDefault();openModal(br.getAttribute('data-browse'))}
});

/* SumUp checkout */
document.getElementById('cof').addEventListener('submit',function(e){
  e.preventDefault();if(!cart.length)return;
  var nm=document.getElementById('nm').value;
  var em=document.getElementById('em').value;
  /* Build SumUp Pay link — replace MERCHANT_CODE with your real SumUp merchant code */
  var amount=total().toFixed(2);
  var desc=cart.map(function(x){return x.t}).join(', ');
  var sumupUrl='https://pay.sumup.com/b2c/MEBCSZ61'
    +'?amount='+amount
    +'&currency=BGN'
    +'&title='+encodeURIComponent('WASD Enterprise – Дигитални книги')
    +'&description='+encodeURIComponent(desc)
    +'&email='+encodeURIComponent(em)
    +'&name='+encodeURIComponent(nm);
  document.getElementById('okm').classList.add('show');
  /* Redirect to SumUp payment page */
  window.open(sumupUrl,'_blank');
});

window.addEventListener('hashchange',route);badge(false);route();
})();
</script>
</body>
